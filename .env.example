# Copy to .env and fill in what you need. Every key is optional; a tool that needs a
# missing key tells the agent exactly which variable to set.

# Voice-over (TTS) and captions (Whisper). https://console.groq.com
GROQ_API_KEY=

# Stock images: set one of the two. https://www.pexels.com/api/  https://unsplash.com/developers
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# HTTP mode only (CLAPPER_TRANSPORT=http): clients must send "Authorization: Bearer <token>".
# Generate one with:  openssl rand -hex 32
CLAPPER_TOKEN=
